---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  accent?: string;
}

const {
  title = "dart_jsonwebtoken — JWT for Dart",
  description = "Sign, decode and verify JSON Web Tokens with every standard algorithm — HMAC, RSA, RSA-PSS, ECDSA, EdDSA. One import, zero ceremony.",
  accent = "#7dff9e",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ accent }}>
      document.documentElement.style.setProperty("--accent", accent);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  accent?: string;
}

const {
  title = "dart_jsonwebtoken — JWT for Dart",
  description = "Sign, decode and verify JSON Web Tokens with every standard algorithm — HMAC, RSA, RSA-PSS, ECDSA, EdDSA. One import, zero ceremony.",
  accent = "#7dff9e",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dart-jwt.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dart-jwt.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dart-jwt.com — sign & verify JWTs in Dart" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dart-jwt.com/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ accent }}>
      document.documentElement.style.setProperty("--accent", accent);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
